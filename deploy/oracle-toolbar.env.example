# Copy to .env at the root of the toolbar.deckcelerate.com checkout (same
# directory as docker-compose.yml, once you've copied
# oracle-toolbar.docker-compose.yml there). Never commit the real .env.

# Not secrets, just kept here alongside everything else so this one file
# covers every value that differs from beta's .env.
DOMAIN=toolbar.deckcelerate.com
MANIFEST_ID=7cf8b782-10b1-434b-86bc-1f64ca6b2860

# Your Azure App Registration's client ID (not the old gavinchow.me one,
# unless you're intentionally sharing it). Same value as beta's .env if
# both are meant to use one App Registration (recommended — src/config/
# auth.json is one file, shared by every checkout regardless), otherwise
# whatever your new App Registration's client ID is.
AZURE_CLIENT_ID=

# Comma-separated, case-insensitive. Whoever's email matches (from the
# verified Microsoft ID token) gets isAdmin=true at session time. Same
# admins as beta is fine — just don't reuse SESSION_SECRET/
# POSTGRES_PASSWORD across the two environments.
ADMIN_EMAILS=you@example.com

# Random long string used to sign session cookies. MUST be different from
# beta's — otherwise a session cookie minted on one instance would verify
# as valid on the other. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Postgres password — used both by the db service and by the app's
# DATABASE_URL (see docker-compose.yml). Each Postgres container is
# already isolated on its own Docker network, but keep this distinct from
# beta's too.
POSTGRES_PASSWORD=
