# Copy to .env at the root of the beta.deckcelerate.com checkout (same
# directory as docker-compose.yml, once you've copied
# oracle-beta.docker-compose.yml there). Never commit the real .env.

# Not secrets, just kept here alongside everything else. MANIFEST_ID must
# be different from the toolbar instance's — see the toolbar compose
# file's header for why.
DOMAIN=beta.deckcelerate.com
MANIFEST_ID=28c2c37d-8169-4ada-ae3e-a24182c6eca8

ADMIN_EMAILS=you@example.com

# MUST be different from the toolbar instance's SESSION_SECRET. Generate
# with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# Should also differ from the toolbar instance's value.
POSTGRES_PASSWORD=
